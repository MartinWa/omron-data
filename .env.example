OMRON_SECRET_KEY=
OMRON_ALLOWED_HOSTS=omron.example.com
OMRON_IMAGE=ghcr.io/martinwa/omron-data:latest
OMRON_SECRET_KEY_FILE=
OMRON_TIME_ZONE=Europe/Stockholm
OMRON_CSRF_TRUSTED_ORIGINS=
# Required behind the TLS proxy: the value `*` for a proxy on the private network, or the
# proxy's own address. Left empty, waitress discards X-Forwarded-Proto and every browser
# login fails the CSRF origin check.
OMRON_TRUSTED_PROXY=
OMRON_HOST_PORT=8000
OMRON_NETWORK=omron-data
PROXY_NETWORK=proxy
PUID=1000
PGID=1000
# Generate OMRON_SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The container refuses to start while it is empty or a published placeholder.
